# ─── Ma'lumotlar bazasi ───
# PostgreSQL ulanish satri. PAROL va port ni o'zingiznikiga moslang.
DATABASE_URL="postgresql://postgres:PAROL@localhost:5432/dorixona?schema=public"

# ─── F-Apteka REPORT.exe integratsiyasi ───
# Variant 1: to'liq endpoint
FAPTEKA_REPORT_URL=""
# Variant 2: faqat server manzili, masalan http://192.168.1.10:8084
FAPTEKA_REPORT_BASE_URL=""
FAPTEKA_FILIAL_ID="1"
# Agar FOM GROUP token/header talab qilsa, ixtiyoriy:
FAPTEKA_REPORT_TOKEN=""

# ─── F-Apteka SITE.exe push integratsiyasi ───
# SITE.exe qoldiq/mahsulot XML yuboradigan public endpoint uchun.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
FAPTEKA_SITE_TOKEN="uzoq-maxfiy-token"

# ─── Auth.js (NextAuth) ───
# Yangi maxfiy kalit: `npx auth secret`
AUTH_SECRET="bu-yerga-maxfiy-kalit-qoying"
AUTH_TRUST_HOST="true"

# ─── Telegram bot ───
# @BotFather dan token oling
TELEGRAM_BOT_TOKEN=""
# Admin Mini App uchun Telegram user ID lar (vergul bilan)
TELEGRAM_ADMIN_IDS=""
# Vercel domeni yoki to'liq Mini App URL:
# https://your-project.vercel.app yoki https://your-project.vercel.app/tg-admin
TELEGRAM_WEBAPP_URL=""
NEXT_PUBLIC_TELEGRAM_WEBAPP_URL=""
# Vercel webhook setup endpointi uchun bir martalik maxfiy kalit
TELEGRAM_WEBHOOK_SETUP_KEY=""
